<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="group.lab6.lab6.controller.MainController">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="Выйти">
                    <MenuItem text="Выход" onAction="#handleExit"/>
                </Menu>
                <Menu text="Операции">
                    <MenuItem text="Добавить новую пластинку" onAction="#handleAddNewInstance"/>
                    <MenuItem text="Добавить Б/У пластинку" onAction="#handleAddUsedInstance"/>
                    <MenuItem text="Редактировать экземпляр" onAction="#handleEditInstance"/>
                    <MenuItem text="Управление фото" onAction="#handleManagePhotos"/>
                    <MenuItem text="Управление поставщиками" onAction="#handleManageSuppliers"/>
                    <MenuItem text="Управление продавцами" onAction="#handleManageSellers"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Отчёты" onAction="#handleReports"/>
                </Menu>
                <Menu text="Справка">
                    <MenuItem text="О программе" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Поиск:"/>
                <TextField fx:id="quickSearchField" promptText="Исполнитель или название"/>
                <Label text="Жанр:"/>
                <ComboBox fx:id="genreFilterComboBox" prefWidth="150"/>
                <Label text="Состояние:"/>
                <ComboBox fx:id="conditionFilterComboBox" prefWidth="150"/>
                <Button text="Найти" onAction="#handleQuickSearch" defaultButton="true"/>
                <Button text="Сбросить" onAction="#handleResetFilters"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" alignment="TOP_CENTER">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <GridPane hgap="10" vgap="10">
                <Label text="Способ оплаты:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="paymentMethodComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Продать" onAction="#handleSellFromMain" defaultButton="true"/>
                <Button text="Архивировать" onAction="#handleArchive"/>
            </HBox>

            <Label text="Доступные пластинки"/>
            <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" prefHeight="400">
                <columns>
                    <TableColumn fx:id="artistColumn" text="Исполнитель" prefWidth="150"/>
                    <TableColumn fx:id="albumColumn" text="Альбом" prefWidth="150"/>
                    <TableColumn fx:id="genreColumn" text="Жанр" prefWidth="100"/>
                    <TableColumn fx:id="conditionColumn" text="Состояние" prefWidth="100"/>
                    <TableColumn fx:id="priceColumn" text="Цена" prefWidth="80"/>
                    <TableColumn fx:id="locationColumn" text="Местоположение" prefWidth="150"/>
                    <TableColumn fx:id="formatColumn" text="Формат" prefWidth="80"/>
                    <TableColumn fx:id="speedColumn" text="Скорость" prefWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Обновить список" onAction="#handleRefreshAvailable"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label fx:id="userLabel" text="Пользователь: "/>
            <Button text="Сменить язык" onAction="#handleChangeLanguage"/>
        </HBox>
    </bottom>

</BorderPane>