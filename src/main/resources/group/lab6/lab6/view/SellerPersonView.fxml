<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="group.lab6.lab6.controller.SellerPersonController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Управление продавцами"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Загрузить список" onAction="#handleLoadSellers"/>
        <Button text="Очистить форму" onAction="#handleClearForm"/>
    </HBox>

    <GridPane hgap="10" vgap="10">
        <Label text="Имя:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

        <Label text="Фамилия:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

        <Label text="Отчество:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="patronymicField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>

        <Label text="Телефон:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Добавить" onAction="#handleAdd"/>
        <Button text="Обновить" onAction="#handleUpdate"/>
        <Button text="Архивировать" onAction="#handleArchive"/>
    </HBox>

    <TableView fx:id="sellerTable" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="lastNameColumn" text="Фамилия" prefWidth="120"/>
            <TableColumn fx:id="firstNameColumn" text="Имя" prefWidth="120"/>
            <TableColumn fx:id="patronymicColumn" text="Отчество" prefWidth="120"/>
            <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="statusLabel"/>

</VBox>