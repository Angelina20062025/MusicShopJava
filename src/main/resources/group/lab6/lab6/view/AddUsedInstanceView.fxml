<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="group.lab6.lab6.controller.AddUsedInstanceController">
    <content>
        <VBox spacing="15" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Добавление Б/У пластинки"/>

            <!-- Каталоговый номер -->
            <GridPane hgap="10" vgap="10">
                <Label text="Каталоговый номер:*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="catalogNumberField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"
                           promptText="Введите каталоговый номер и нажмите Tab"/>
            </GridPane>

            <Separator prefHeight="10"/>

            <!-- Информация о релизе -->
            <Label text="Информация о релизе"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Исполнитель:*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="artistField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"
                           editable="false"/>

                <Label text="Название альбома:*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="albumField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           editable="false"/>

                <Label text="Жанр:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="genreComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250" editable="false"/>

                <Label text="Лейбл:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="labelField" GridPane.rowIndex="3" GridPane.columnIndex="1"
                           editable="false"/>

                <Label text="Страна:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="countryField" GridPane.rowIndex="4" GridPane.columnIndex="1"
                           editable="false"/>

                <Label text="Год выпуска:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="yearField" GridPane.rowIndex="5" GridPane.columnIndex="1"
                           editable="false"/>

                <Label text="Описание:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="descriptionField" GridPane.rowIndex="6" GridPane.columnIndex="1"
                           editable="false"/>
            </GridPane>

            <Separator prefHeight="10"/>

            <Label text="Данные экземпляра"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Цена:*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="priceField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Формат:*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="formatComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Скорость:*" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="speedComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Состояние винила:*" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="vinylConditionComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Состояние обложки:*" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="coverConditionComboBox" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Примечания о дефектах:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="defectsNotesField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Стеллаж:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="shelfField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Секция:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextField fx:id="sectionField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <Label text="Коробка:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextField fx:id="boxField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            </GridPane>

            <Separator prefHeight="10"/>

            <Label text="Информация о продавце"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Продавец:*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="sellerComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" promptText="Выберите продавца"/>
                <Button text="Управление продавцами" onAction="#handleManageSellers" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            </GridPane>

            <Label fx:id="statusLabel"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Очистить" onAction="#handleClear"/>
                <Button text="Добавить" onAction="#handleAdd" defaultButton="true"/>
                <Button text="Отмена" onAction="#handleCancel"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>
