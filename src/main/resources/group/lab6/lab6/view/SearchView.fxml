<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="group.lab6.lab6.controller.SearchController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Поиск пластинок в наличии"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Исполнитель:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="artistField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Название альбома:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="albumField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Жанр:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="genreComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200" promptText="Все жанры"/>

        <Label text="Состояние:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="conditionComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200" promptText="Все состояния"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Искать" onAction="#handleSearch" defaultButton="true"/>
        <Button text="Сбросить" onAction="#handleReset"/>
    </HBox>

    <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="artistColumn" text="Исполнитель" prefWidth="150"/>
            <TableColumn fx:id="albumColumn" text="Альбом" prefWidth="150"/>
            <TableColumn fx:id="genreColumn" text="Жанр" prefWidth="100"/>
            <TableColumn fx:id="conditionColumn" text="Состояние" prefWidth="100"/>
            <TableColumn fx:id="priceColumn" text="Цена" prefWidth="80"/>
            <TableColumn fx:id="locationColumn" text="Местоположение" prefWidth="150"/>
            <TableColumn fx:id="formatColumn" text="Формат" prefWidth="80"/>
            <TableColumn fx:id="speedColumn" text="Скорость" prefWidth="80"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Продать выбранную" onAction="#handleSell"/>
        <Button text="Закрыть" onAction="#handleClose"/>
    </HBox>

    <Label fx:id="statusLabel"/>

</VBox>