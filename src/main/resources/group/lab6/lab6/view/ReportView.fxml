<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="group.lab6.lab6.controller.ReportController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Отчёты" />

    <!-- Блок текущей стоимости коллекции -->
    <GridPane hgap="10" vgap="10">
        <Label text="Текущая стоимость коллекции:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="collectionValueLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Обновить" onAction="#handleRefreshCollectionValue" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Button text="Сохранить стоимость коллекции" onAction="#handleSaveCollectionValue" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
    </GridPane>

    <!-- Блок отчёта по продажам -->
    <Label text="Отчёт по продажам"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Дата начала:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="startDatePicker" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="150"/>

        <Label text="Дата окончания:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <DatePicker fx:id="endDatePicker" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="150"/>

        <Button text="Сформировать отчёт" onAction="#handleGenerateReport" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
        <Button text="Сохранить отчёт" onAction="#handleSaveReport" GridPane.rowIndex="0" GridPane.columnIndex="5"/>
    </GridPane>

    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" prefHeight="400">
        <columns>
            <TableColumn fx:id="saleDateColumn" text="Дата продажи" prefWidth="120"/>
            <TableColumn fx:id="checkNumberColumn" text="Номер чека" prefWidth="120"/>
            <TableColumn fx:id="artistColumn" text="Исполнитель" prefWidth="150"/>
            <TableColumn fx:id="albumColumn" text="Альбом" prefWidth="150"/>
            <TableColumn fx:id="priceColumn" text="Цена" prefWidth="80"/>
            <TableColumn fx:id="paymentMethodColumn" text="Способ оплаты" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="statusLabel"/>

</VBox>